# Copiez ce fichier vers `.env`, puis adaptez les valeurs.
# `.env` est ignoré par Git et ne doit jamais être versionné.

# Obligatoire. Générez une clé unique par environnement :
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=remplacez-moi

# --- Développement local ---------------------------------------------------
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_TRUST_PROXY_HEADERS=False

# --- Production (remplacez le bloc ci-dessus) ------------------------------
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=nteri.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://nteri.example.com
# DJANGO_CORS_ALLOWED_ORIGINS=https://nteri.example.com
# Activer uniquement derrière un reverse proxy de confiance.
# DJANGO_TRUST_PROXY_HEADERS=True

# --- Infrastructure --------------------------------------------------------
# Redis est nécessaire pour un déploiement multi-processus ou serverless
# (WebSockets). En production, utilisez une URL TLS `rediss://` (Upstash).
# REDIS_URL=redis://127.0.0.1:6379/0
# DATABASE_URL=postgresql://nteri:motdepasse@127.0.0.1:5432/nteri

# Supabase (intégration Vercel) : les variables peuvent être nommées
# DATABASE_POSTGRES_URL, POSTGRES_URL, POSTGRES_PRISMA_URL, etc.
# Le backend les utilise automatiquement hors DEBUG si DATABASE_URL est absent.
# DATABASE_POSTGRES_URL=postgresql://postgres.<ref>:motdepasse@...pooler.supabase.com:6543/postgres?sslmode=require
# Optionnel : URL non poolée réservée aux migrations du build Vercel.
# DATABASE_MIGRATION_URL=postgresql://postgres.<ref>:motdepasse@...pooler.supabase.com:5432/postgres?sslmode=require

# --- Connexion par SMS ------------------------------------------------------
# En développement, `console` affiche le code dans les logs Django. En
# production, configurez impérativement une passerelle réelle :
# `twilio` ou `http` (webhook générique).
# NTERI_SMS_BACKEND=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# NTERI_SMS_WEBHOOK_URL=https://votre-passarelle.example.com/sms
# NTERI_SMS_WEBHOOK_TOKEN=
# En développement uniquement : renvoyer le code dans la réponse API.
# NTERI_EXPOSE_OTP=True

# --- Notifications Web Push -------------------------------------------------
# Générez une paire VAPID (py-vapid) et renseignez-la pour recevoir les
# notifications lorsque l’application est fermée. Sans clés, les notifications
# restent locales à l’onglet ouvert.
# NTERI_VAPID_PUBLIC_KEY=
# NTERI_VAPID_PRIVATE_KEY=
# NTERI_VAPID_SUBJECT=mailto:contact@nteri.app
# Hôtes des services Push autorisés (suffixes séparés par des virgules).
# NTERI_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,notify.windows.com

# --- Vercel ----------------------------------------------------------------
# VERCEL_URL et VERCEL_PROJECT_PRODUCTION_URL sont fournies automatiquement
# par Vercel ; ne pas les définir manuellement.
# Sur Vercel, laissez les connexions PostgreSQL courtes :
# DB_CONN_MAX_AGE=0

# --- Démonstration uniquement ---------------------------------------------
# Utilisé par `manage.py seed_demo`. Ne pas définir en production.
# NTERI_DEMO_PASSWORD=NteriDemo2026!
